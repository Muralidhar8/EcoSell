# Flask Environment Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=smart_waste_management

# Optional Direct Database URL override (e.g. mysql+pymysql://user:pass@host:3306/db or sqlite:///ecosell.db)
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/smart_waste_management?charset=utf8mb4

